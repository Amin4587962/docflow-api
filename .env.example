# Database Configuration
# This value matches the default local Docker Compose configuration.
DATABASE_URL=postgresql+asyncpg://docflow_user:docflow_password@postgres:5432/docflow_db

# Security and JWT Configuration
# Use a long, random secret value in production.
SECRET_KEY=replace_with_a_long_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Celery / Redis Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
